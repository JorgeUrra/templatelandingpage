---
import { siteConfig, activeTheme } from '../config/site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = siteConfig.seo.title, description = siteConfig.seo.description } = Astro.props;
const isServices = siteConfig.businessType === 'services';
const whatsappUrl = `https://wa.me/${siteConfig.business.whatsapp}?text=${encodeURIComponent('Hola, quiero solicitar una cotización a ' + siteConfig.business.name)}`;
const homePath = Astro.url.pathname === '/' ? '' : '/';
---
<!doctype html>
<html lang="es" class={activeTheme.className}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {isServices && <link rel="icon" type="image/png" href="/images/peumatek-icon.png" />}
    {isServices && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" />
      </>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteConfig.seo.image} />
    <meta name="theme-color" content={activeTheme.primary} />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href={`${homePath}#inicio`} class="brand" aria-label={siteConfig.business.name}>
          {isServices ? (
            <img class="brand__svg" src="/images/peumatek-icon.png" alt="PeumaTek" width="42" height="42" />
          ) : (
            <span class="brand__mark">{siteConfig.business.logoText}</span>
          )}
          {isServices ? (
            <span>Peuma<em class="brand-accent">Tek</em></span>
          ) : (
            <span>{siteConfig.business.name}</span>
          )}
        </a>
        <nav class="nav">
          {isServices ? (
            <>
              <a href={`${homePath}#servicios`}>Servicios</a>
              <a href={`${homePath}#planes`}>Planes</a>
              <a href={`${homePath}#portafolio`}>Proyectos</a>
              <a href={`${homePath}#about`}>Quién está detrás</a>
              <a href={`${homePath}#contacto`}>Contacto</a>
            </>
          ) : (
            <>
              <a href={`${homePath}#beneficios`}>Beneficios</a>
              {siteConfig.businessType === 'gym' && <a href={`${homePath}#planes-gimnasio`}>Planes</a>}
              {siteConfig.businessType === 'automotive' && <a href={`${homePath}#vehiculos`}>Vehículos</a>}
              <a href={`${homePath}#faq`}>FAQ</a>
              <a href={`${homePath}#contacto`}>Contacto</a>
            </>
          )}
        </nav>
        {isServices && (
          <a href={`${homePath}#contacto`} class="btn btn--primary header-cta">Solicitar cotización</a>
        )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>{siteConfig.business.name}</strong>
          <p>{siteConfig.business.description}</p>
          {isServices && Object.values(siteConfig.social).some(Boolean) && (
            <div class="footer-social">
              {siteConfig.social.github && <a href={siteConfig.social.github} target="_blank" rel="noopener">GitHub</a>}
              {siteConfig.social.linkedin && <a href={siteConfig.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
              {siteConfig.social.instagram && <a href={siteConfig.social.instagram} target="_blank" rel="noopener">Instagram</a>}
            </div>
          )}
        </div>
        <div>
          <p>{siteConfig.business.city}</p>
          <p>{siteConfig.business.email}</p>
          {isServices && <p class="footer-tagline">{siteConfig.business.slogan}</p>}
        </div>
      </div>
    </footer>
    <script>
      // Spotlight hover: cada card .js-spotlight recibe la posición del cursor
      // en variables CSS (--mx/--my) para iluminar suavemente bajo el mouse.
      const spotlightCards = document.querySelectorAll('.js-spotlight');
      spotlightCards.forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
          card.style.setProperty('--my', `${event.clientY - rect.top}px`);
        });
      });
    </script>
  </body>
</html>
