---
import SectionHeader from '../shared/SectionHeader.astro';
import { siteConfig } from '../../config/site.config';
const links = Object.entries(siteConfig.social).filter(([, value]) => Boolean(value));
---
{links.length > 0 && (
  <section class="section" id="redes">
    <div class="container container--narrow">
      <SectionHeader eyebrow="Redes" title="También puedes encontrarnos aquí" />
      <div class="social-list">
        {links.map(([name, url]) => (
          <a href={url as string} target="_blank" class="social-link">{name}</a>
        ))}
      </div>
    </div>
  </section>
)}
