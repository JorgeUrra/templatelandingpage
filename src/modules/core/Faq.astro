---
import SectionHeader from '../shared/SectionHeader.astro';
import { faqs } from '../../data/core';
---
<section class="section section--muted" id="faq">
  <div class="container container--narrow">
    <SectionHeader eyebrow="FAQ" title="Preguntas frecuentes" description="Preguntas que reducen dudas y mejoran la conversión antes del contacto." />
    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
