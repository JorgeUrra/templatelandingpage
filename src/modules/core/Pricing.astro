---
import SectionHeader from '../shared/SectionHeader.astro';
import Button from '../shared/Button.astro';
import { pricingPlans } from '../../data/core';
import { pricingNote } from '../../data/peumatek';
import { siteConfig } from '../../config/site.config';

const isServices = siteConfig.businessType === 'services';
const whatsappUrl = `https://wa.me/${siteConfig.business.whatsapp}?text=${encodeURIComponent('Hola, quiero consultar por un plan de landing page')}`;
const ctaHref = isServices ? '#contacto' : whatsappUrl;
const ctaTarget = isServices ? undefined : '_blank';
---
<section class="section" id="planes">
  <div class="container">
    <SectionHeader
      eyebrow="Planes"
      title={isServices ? 'Planes para landing pages' : 'Planes configurables'}
      description={isServices
        ? 'Opciones pensadas para negocios que necesitan una presencia digital profesional lista para funcionar.'
        : 'Este módulo sirve para membresías, servicios, paquetes o precios referenciales.'}
    />
    <div class="grid grid--3 pricing-grid">
      {pricingPlans.map((plan) => (
        <article class:list={["card", "pricing-card", plan.highlighted && "pricing-card--highlighted"]}>
          {plan.highlighted && <span class="pill">Más solicitado</span>}
          <h3>{plan.name}</h3>
          <div class="price">{plan.price}</div>
          <p class="muted">{plan.period}</p>
          {'note' in plan && plan.note && <p class="pricing-condition">{plan.note}</p>}
          <p>{plan.description}</p>
          <ul class="check-list">
            {plan.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <Button href={ctaHref} target={ctaTarget} label={plan.ctaText} variant={plan.highlighted ? 'primary' : 'secondary'} />
        </article>
      ))}
    </div>
    {isServices && <p class="pricing-note">{pricingNote}</p>}
  </div>
</section>
