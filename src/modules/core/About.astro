---
import SectionHeader from '../shared/SectionHeader.astro';
import Button from '../shared/Button.astro';
import { siteConfig } from '../../config/site.config';
import { aboutPeumatek, techStack } from '../../data/peumatek';

const whatsappUrl = `https://wa.me/${siteConfig.business.whatsapp}?text=${encodeURIComponent('Hola, quiero contactar con ' + siteConfig.business.name)}`;

// Avatar deshabilitado temporalmente (sin foto ni ilustración) a pedido del usuario.
// Para mostrar una foto real más adelante, define aboutPeumatek.profilePhoto.
---

<section class="section section--muted" id="about">
  <div class="container">
    <div class="about-grid">
      <article class="card about-profile js-spotlight">
        <span class="spotlight" aria-hidden="true"></span>
        {aboutPeumatek.profilePhoto && (
          <div class="about-avatar-wrap">
            <img class="about-avatar about-avatar--photo" src={aboutPeumatek.profilePhoto} alt={aboutPeumatek.profileName} width="100" height="100" />
          </div>
        )}
        <div class="about-profile-info">
          <strong>{aboutPeumatek.profileName}</strong>
          <span class="muted">{aboutPeumatek.profileTitle}</span>
        </div>
        <span class="about-location">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s-6-5.2-6-10a6 6 0 0 1 12 0c0 4.8-6 10-6 10z" />
            <circle cx="12" cy="11" r="2.2" />
          </svg>
          {siteConfig.business.city}
        </span>
        <div class="about-actions">
          <Button href="#contacto" label="Solicitar cotización" variant="primary" />
          <Button href={whatsappUrl} target="_blank" label="Hablar por WhatsApp" variant="whatsapp" />
        </div>
      </article>

      <div class="about-content">
        <SectionHeader eyebrow={aboutPeumatek.eyebrow} title={aboutPeumatek.title} align="left" />
        <p class="about-intro">{aboutPeumatek.intro}</p>
        <ul class="about-points">
          {aboutPeumatek.trustPoints.map((point) => <li>{point}</li>)}
        </ul>
        <div class="about-tech">
          <span class="about-tech__label">Stack principal</span>
          <div class="about-tech__grid">
            {techStack.map((t) => (
              <span class="about-tech__item">
                <img src={`/images/tech/${t.slug}.svg`} alt={t.name} width="22" height="22" loading="lazy" />
                <span>{t.name}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
