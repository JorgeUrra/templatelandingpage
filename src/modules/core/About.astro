---
import SectionHeader from '../shared/SectionHeader.astro';
import Button from '../shared/Button.astro';
import { siteConfig } from '../../config/site.config';
import { aboutPeumatek, techStack } from '../../data/peumatek';

const whatsappUrl = `https://wa.me/${siteConfig.business.whatsapp}?text=${encodeURIComponent('Hola, quiero contactar con ' + siteConfig.business.name)}`;

// Avatar ilustrado (dibujo, no foto): desarrollador con barba y audífonos sobre líneas de código.
const devAvatar = '<svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="100" height="100" fill="var(--surface)"/><rect x="12" y="13" width="18" height="3" rx="1.5" fill="var(--primary)" opacity="0.22"/><rect x="12" y="19" width="11" height="3" rx="1.5" fill="var(--peumo,#F07820)" opacity="0.45"/><rect x="73" y="13" width="15" height="3" rx="1.5" fill="var(--primary)" opacity="0.2"/><rect x="77" y="19" width="11" height="3" rx="1.5" fill="var(--primary)" opacity="0.15"/><path d="M16 99 C16 76 32 67 50 67 C68 67 84 76 84 99 Z" fill="var(--primary)"/><rect x="44.5" y="54" width="11" height="13" rx="5" fill="#E7B68E"/><circle cx="34.5" cy="42" r="3" fill="#E7B68E"/><circle cx="65.5" cy="42" r="3" fill="#E7B68E"/><ellipse cx="50" cy="41" rx="15.5" ry="17" fill="#E7B68E"/><path d="M34 41 C33 26 40 22 50 22 C60 22 67 26 66 41 C66 34 59 30 50 30 C41 30 34 34 34 41 Z" fill="#4A3B2E"/><path d="M40.5 35.5 C42 34.5 45.5 34.5 47 35.5" stroke="#4A3B2E" stroke-width="1.4" fill="none" stroke-linecap="round"/><path d="M53 35.5 C54.5 34.5 58 34.5 59.5 35.5" stroke="#4A3B2E" stroke-width="1.4" fill="none" stroke-linecap="round"/><path d="M34.5 42 C36 47 43 49 50 49 C57 49 64 47 65.5 42 C66 55 58 63 50 63 C42 63 34 55 34.5 42 Z" fill="#4A3B2E"/><path d="M43 46.5 C46 48.5 54 48.5 57 46.5 C55.5 50.5 44.5 50.5 43 46.5 Z" fill="#4A3B2E"/><circle cx="44" cy="40" r="1.6" fill="#2A2018"/><circle cx="56" cy="40" r="1.6" fill="#2A2018"/><circle cx="44" cy="40" r="4.2" fill="none" stroke="#2A2018" stroke-width="1.2"/><circle cx="56" cy="40" r="4.2" fill="none" stroke="#2A2018" stroke-width="1.2"/><path d="M48.2 40 H51.8" stroke="#2A2018" stroke-width="1.2"/><path d="M31 42 C31 26 39 20 50 20 C61 20 69 26 69 42" stroke="var(--peumo,#F07820)" stroke-width="3.4" fill="none" stroke-linecap="round"/><rect x="28" y="38" width="7" height="11" rx="3.5" fill="var(--peumo,#F07820)"/><rect x="65" y="38" width="7" height="11" rx="3.5" fill="var(--peumo,#F07820)"/></svg>';
---

<section class="section section--muted" id="about">
  <div class="container">
    <div class="about-grid">
      <article class="card about-profile js-spotlight">
        <span class="spotlight" aria-hidden="true"></span>
        <div class="about-avatar-wrap">
          <svg class="about-aura" viewBox="0 0 150 150" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <line x1="75" y1="75" x2="22" y2="34" stroke="currentColor" stroke-opacity="0.3" stroke-width="1.4" />
            <line x1="75" y1="75" x2="128" y2="48" stroke="var(--peumo,#F07820)" stroke-opacity="0.45" stroke-width="1.4" />
            <line x1="75" y1="75" x2="116" y2="120" stroke="currentColor" stroke-opacity="0.3" stroke-width="1.4" />
            <circle cx="22" cy="34" r="4" fill="currentColor" opacity="0.7" />
            <circle cx="128" cy="48" r="4.5" fill="var(--peumo,#F07820)" />
            <circle cx="116" cy="120" r="3.5" fill="currentColor" opacity="0.6" />
          </svg>
          {aboutPeumatek.profilePhoto
            ? <img class="about-avatar about-avatar--photo" src={aboutPeumatek.profilePhoto} alt={aboutPeumatek.profileName} width="100" height="100" />
            : <span class="about-avatar about-avatar--illus" set:html={devAvatar}></span>}
        </div>
        <div class="about-profile-info">
          <strong>{aboutPeumatek.profileName}</strong>
          <span class="muted">{aboutPeumatek.profileTitle}</span>
        </div>
        <span class="about-location">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s-6-5.2-6-10a6 6 0 0 1 12 0c0 4.8-6 10-6 10z" />
            <circle cx="12" cy="11" r="2.2" />
          </svg>
          {siteConfig.business.city}
        </span>
        <div class="about-actions">
          <Button href="#contacto" label="Solicitar cotización" variant="primary" />
          <Button href={whatsappUrl} target="_blank" label="Hablar por WhatsApp" variant="whatsapp" />
        </div>
      </article>

      <div class="about-content">
        <SectionHeader eyebrow={aboutPeumatek.eyebrow} title={aboutPeumatek.title} align="left" />
        <p class="about-intro">{aboutPeumatek.intro}</p>
        <ul class="about-points">
          {aboutPeumatek.trustPoints.map((point) => <li>{point}</li>)}
        </ul>
        <div class="about-tech">
          <span class="about-tech__label">Stack principal</span>
          <div class="about-tech__grid">
            {techStack.map((t) => (
              <span class="about-tech__item">
                <img src={`/images/tech/${t.slug}.svg`} alt={t.name} width="22" height="22" loading="lazy" />
                <span>{t.name}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
