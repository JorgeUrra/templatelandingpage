---
import SectionHeader from '../shared/SectionHeader.astro';
import Button from '../shared/Button.astro';
import { siteConfig } from '../../config/site.config';

const { phone, email, city } = siteConfig.business;
const whatsappUrl = `https://wa.me/${siteConfig.business.whatsapp}?text=${encodeURIComponent('Hola, quiero más información sobre ' + siteConfig.business.name)}`;

// Evita enlaces rotos mientras los datos sean placeholders ([AGREGAR_...]).
const isReal = (value: string) => Boolean(value) && !value.includes('[');
---
<section class="section section--contact" id="contacto">
  <div class="container contact-grid">
    <div class="contact-intro">
      <SectionHeader
        align="left"
        eyebrow="Contacto"
        title="Cuéntame qué necesitas desarrollar"
        description="Escríbeme por WhatsApp o déjame tus datos en el formulario. Te respondo con una propuesta clara, sin compromiso."
      />
      <div class="contact-methods">
        <a class="contact-method" href={whatsappUrl} target="_blank" rel="noopener">
          <span class="contact-method__icon contact-method__icon--wa"><span class="wa-glyph"></span></span>
          <span class="contact-method__text">
            <span class="contact-method__label">WhatsApp</span>
            <strong>{isReal(phone) ? phone : 'Escríbeme directo'}</strong>
          </span>
        </a>

        {isReal(email) ? (
          <a class="contact-method" href={`mailto:${email}`}>
            <span class="contact-method__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
            </span>
            <span class="contact-method__text">
              <span class="contact-method__label">Correo</span>
              <strong>{email}</strong>
            </span>
          </a>
        ) : (
          <div class="contact-method contact-method--static">
            <span class="contact-method__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
            </span>
            <span class="contact-method__text">
              <span class="contact-method__label">Correo</span>
              <strong>{email}</strong>
            </span>
          </div>
        )}

        <div class="contact-method contact-method--static">
          <span class="contact-method__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6-5.2-6-10a6 6 0 0 1 12 0c0 4.8-6 10-6 10z" /><circle cx="12" cy="11" r="2.2" /></svg>
          </span>
          <span class="contact-method__text">
            <span class="contact-method__label">Ubicación</span>
            <strong>{city}</strong>
          </span>
        </div>
      </div>

      <Button href={whatsappUrl} target="_blank" label="Hablar por WhatsApp" variant="whatsapp" />
    </div>

    <form class="card contact-form" action="/api/contact" method="post">
      <input type="hidden" name="origen" value="Formulario de contacto PeumaTek" />
      <label>Nombre<input name="nombre" autocomplete="name" required placeholder="Tu nombre" /></label>
      <label>Teléfono<input name="telefono" type="tel" autocomplete="tel" required placeholder="+56 9..." /></label>
      <label>Correo<input name="email" type="email" autocomplete="email" placeholder="correo@ejemplo.cl" /></label>
      <label>¿Qué necesitas?<textarea name="mensaje" rows="4" placeholder="Cuéntame brevemente tu idea o problema a resolver"></textarea></label>
      <button class="btn btn--primary" type="submit">
        <span>Enviar consulta</span>
        <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>
  </div>
</section>
