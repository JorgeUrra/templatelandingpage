---
import SectionHeader from '../shared/SectionHeader.astro';
import { workProcess } from '../../data/peumatek';
import { lineIcons } from '../../data/icons';
---

<section class="section" id="proceso">
  <div class="container">
    <SectionHeader
      eyebrow="Cómo trabajo"
      title="Proceso de trabajo"
      description="Cada proyecto sigue un camino claro: sabes en qué etapa estamos y qué sigue."
      align="center"
    />
    <ol class="process-flow">
      {workProcess.map((item) => (
        <li class="process-flow__step">
          <span class="process-flow__node" set:html={lineIcons[item.icon] ?? ''}></span>
          <span class="process-flow__num">{item.step}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
