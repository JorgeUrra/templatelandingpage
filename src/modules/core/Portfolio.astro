---
import SectionHeader from '../shared/SectionHeader.astro';
import Button from '../shared/Button.astro';
import { ownApps, solutionCases, portfolioIntro, statusLabels, appScreens } from '../../data/portfolio';
import { scenes } from '../../data/scenes';
import { lineIcons } from '../../data/icons';
---

<section class="section section--muted" id="portafolio">
  <div class="container">
    <SectionHeader
      eyebrow="Proyectos y experiencia"
      title="Experiencia aplicada"
      description={portfolioIntro}
    />

    <!-- Aplicaciones propias -->
    <div class="portfolio-subsection">
      <h3 class="subsection-label">Aplicaciones publicadas y en desarrollo</h3>
      <div class="app-showcase-list">
        {ownApps.map((app, i) => {
          const shots = (app.screenshots && app.screenshots.length)
            ? app.screenshots
            : (app.screenshot ? [app.screenshot] : []);
          const hasFan = shots.length > 1;
          return (
            <article class:list={["card", "app-showcase", "js-spotlight", i % 2 === 1 && "app-showcase--reverse", hasFan && "app-showcase--gallery"]}>
              <span class="spotlight" aria-hidden="true"></span>
              {shots.length > 0 ? (
                <button
                  type="button"
                  class="app-showcase__device app-device-btn"
                  data-shots={JSON.stringify(shots)}
                  aria-label={`Ampliar capturas de ${app.name}`}
                >
                  {hasFan ? (
                    <div class="phone-stack">
                      {shots.slice(0, 3).map((src) => (
                        <div class="phone">
                          <div class="phone__screen"><img src={src} alt={`${app.name} — captura`} loading="lazy" /></div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="phone phone--shot">
                      <div class="phone__screen"><img src={shots[0]} alt={`Captura de ${app.name}`} loading="lazy" /></div>
                    </div>
                  )}
                  <span class="device-expand">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                    </svg>
                    {hasFan ? `Ver las ${shots.length} capturas` : 'Ampliar'}
                  </span>
                </button>
              ) : (
                <div class="app-showcase__device">
                  <div class="phone">
                    <span class="phone__notch"></span>
                    <div class="phone__screen"><span class="phone__placeholder" set:html={appScreens[app.screen ?? ''] ?? ''}></span></div>
                  </div>
                </div>
              )}
              <div class="app-showcase__info">
                <div class="app-showcase__head">
                  <span class="app-icon" set:html={lineIcons[app.icon] ?? ''}></span>
                  <div>
                    <h4>{app.name}</h4>
                    <span class={`app-status app-status--${app.status}`}>{statusLabels[app.status]}</span>
                  </div>
                </div>
                <p>{app.description}</p>
                {app.highlights && app.highlights.length > 0 && (
                  <ul class="app-highlights">
                    {app.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
                <div class="tech-tags">
                  {app.stack.map((tech) => <span class="tech-tag">{tech}</span>)}
                </div>
                <div class="app-actions">
                  {app.platforms.includes('google-play') && (
                    app.playStoreUrl
                      ? <Button href={app.playStoreUrl} target="_blank" label="Ver en Google Play" variant="primary" />
                      : <span class="btn-placeholder">Próximamente en Google Play</span>
                  )}
                  {app.platforms.includes('app-store') && app.appStoreUrl && (
                    <Button href={app.appStoreUrl} target="_blank" label="Ver en App Store" variant="secondary" />
                  )}
                  {app.detailUrl && <Button href={app.detailUrl} label="Ver detalle" variant="ghost" />}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- Casos de solución -->
    <div class="portfolio-subsection">
      <h3 class="subsection-label">Casos de solución desarrollados</h3>
      <div class="grid grid--2">
        {solutionCases.map((item) => (
          <article class="card case-card js-spotlight">
            <span class="spotlight" aria-hidden="true"></span>
            <div class="case-card__visual" aria-hidden="true">
              <span class="case-scene" set:html={scenes[item.visual] ?? ''}></span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.areas && item.areas.length > 0 && (
              <div class="case-areas">
                {item.areas.map((area) => <span class="case-area">{area}</span>)}
              </div>
            )}
            <div class="tech-tags">
              {item.stack.map((tech) => <span class="tech-tag">{tech}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- Visor de capturas (lightbox) -->
  <div class="lightbox" id="app-lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Capturas de la aplicación">
    <div class="lightbox__backdrop" data-close></div>
    <button type="button" class="lightbox__close" data-close aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <div class="lightbox__content">
      <div class="lightbox__viewer">
        <button type="button" class="lightbox__nav" data-prev aria-label="Anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <div class="lightbox__stage"></div>
        <button type="button" class="lightbox__nav" data-next aria-label="Siguiente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </div>
      <div class="lightbox__tools" aria-label="Controles de zoom">
        <button type="button" data-zoom-out aria-label="Alejar">-</button>
        <button type="button" data-zoom-reset aria-label="Restablecer zoom">100%</button>
        <button type="button" data-zoom-in aria-label="Acercar">+</button>
      </div>
      <div class="lightbox__dots"></div>
    </div>
  </div>
</section>

<script>
  const lb = document.getElementById('app-lightbox');
  if (lb) {
    const stage = lb.querySelector('.lightbox__stage');
    const dotsWrap = lb.querySelector('.lightbox__dots');
    const prevBtn = lb.querySelector('[data-prev]');
    const nextBtn = lb.querySelector('[data-next]');
    const zoomOutBtn = lb.querySelector('[data-zoom-out]');
    const zoomResetBtn = lb.querySelector('[data-zoom-reset]');
    const zoomInBtn = lb.querySelector('[data-zoom-in]');
    let shots = [];
    let idx = 0;
    let lastFocus = null;
    let swipeStartX = 0;
    let swipeStartY = 0;
    let panStartX = 0;
    let panStartY = 0;
    let panOriginX = 0;
    let panOriginY = 0;
    let panX = 0;
    let panY = 0;
    let zoom = 1;
    let pinchStartDistance = 0;
    let pinchStartZoom = 1;
    let lastTapAt = 0;
    let lastTapX = 0;
    let lastTapY = 0;
    let suppressTap = false;
    const activePointers = new Map();
    const maxZoom = 3.5;

    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const activeImage = () => stage.querySelector('img:not([hidden])');

    const clampPan = () => {
      const image = activeImage();
      if (!image || zoom <= 1.01) {
        panX = 0;
        panY = 0;
        return;
      }

      const stageRect = stage.getBoundingClientRect();
      const maxX = Math.max(0, ((image.offsetWidth * zoom) - stageRect.width) / 2 + 18);
      const maxY = Math.max(0, ((image.offsetHeight * zoom) - stageRect.height) / 2 + 18);
      panX = clamp(panX, -maxX, maxX);
      panY = clamp(panY, -maxY, maxY);
    };

    const applyZoom = () => {
      clampPan();
      stage.style.setProperty('--zoom', zoom.toFixed(2));
      stage.style.setProperty('--pan-x', `${panX}px`);
      stage.style.setProperty('--pan-y', `${panY}px`);
      stage.dataset.zoomed = String(zoom > 1.01);
      zoomResetBtn.textContent = `${Math.round(zoom * 100)}%`;
    };

    const setZoom = (value, resetPan = false) => {
      zoom = clamp(value, 1, maxZoom);
      if (resetPan || zoom <= 1.01) {
        panX = 0;
        panY = 0;
      }
      applyZoom();
    };

    const resetZoom = () => {
      setZoom(1, true);
    };

    const update = () => {
      stage.querySelectorAll('img').forEach((im, i) => { im.hidden = i !== idx; });
      dotsWrap.querySelectorAll('button').forEach((d, i) => d.setAttribute('aria-current', String(i === idx)));
      resetZoom();
    };

    const render = () => {
      stage.innerHTML = shots.map((src) => `<img src="${src}" alt="Captura de la aplicacion" draggable="false" />`).join('');
      dotsWrap.innerHTML = shots.map((_, i) => `<button type="button" class="lightbox__dot" aria-label="Ir a captura ${i + 1}"></button>`).join('');
      dotsWrap.querySelectorAll('button').forEach((d, i) => d.addEventListener('click', () => { idx = i; update(); }));
      const multi = shots.length > 1;
      prevBtn.style.display = multi ? '' : 'none';
      nextBtn.style.display = multi ? '' : 'none';
      dotsWrap.style.display = multi ? '' : 'none';
      update();
    };

    const open = (s) => {
      shots = s; idx = 0; render();
      lastFocus = document.activeElement;
      lb.hidden = false;
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      lb.querySelector('.lightbox__close').focus();
    };

    const close = () => {
      lb.hidden = true;
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    };

    const go = (n) => {
      if (shots.length < 2) return;
      idx = (idx + n + shots.length) % shots.length;
      update();
    };

    const pointerDistance = () => {
      const points = Array.from(activePointers.values());
      if (points.length < 2) return 0;
      return Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
    };

    const prepareSinglePointer = (point) => {
      swipeStartX = point.x;
      swipeStartY = point.y;
      panStartX = point.x;
      panStartY = point.y;
      panOriginX = panX;
      panOriginY = panY;
    };

    const startGesture = (event) => {
      if (event.button !== undefined && event.button !== 0) return;
      activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      stage.setPointerCapture?.(event.pointerId);
      stage.classList.add('is-swiping');

      if (activePointers.size === 1) {
        prepareSinglePointer({ x: event.clientX, y: event.clientY });
      } else if (activePointers.size === 2) {
        pinchStartDistance = pointerDistance();
        pinchStartZoom = zoom;
      }
    };

    const moveGesture = (event) => {
      if (!activePointers.has(event.pointerId)) return;
      activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

      if (activePointers.size >= 2) {
        event.preventDefault();
        const distance = pointerDistance();
        if (pinchStartDistance > 0 && distance > 0) {
          setZoom(pinchStartZoom * (distance / pinchStartDistance));
        }
        return;
      }

      if (zoom > 1.01) {
        event.preventDefault();
        const point = activePointers.get(event.pointerId);
        panX = panOriginX + point.x - panStartX;
        panY = panOriginY + point.y - panStartY;
        applyZoom();
      }
    };

    const endGesture = (event) => {
      const point = activePointers.get(event.pointerId);
      const wasSinglePointer = activePointers.size === 1;

      if (point && wasSinglePointer && zoom <= 1.01) {
        const deltaX = point.x - swipeStartX;
        const deltaY = point.y - swipeStartY;
        const isHorizontalSwipe = Math.abs(deltaX) > 44 && Math.abs(deltaX) > Math.abs(deltaY) * 1.25;

        if (isHorizontalSwipe) {
          suppressTap = true;
          go(deltaX < 0 ? 1 : -1);
        }
      }

      activePointers.delete(event.pointerId);
      stage.releasePointerCapture?.(event.pointerId);

      if (activePointers.size === 1) {
        prepareSinglePointer(Array.from(activePointers.values())[0]);
      } else {
        stage.classList.remove('is-swiping');
        pinchStartDistance = 0;
      }
    };

    const cancelGesture = () => {
      activePointers.clear();
      stage.classList.remove('is-swiping');
      pinchStartDistance = 0;
    };

    const handleTapZoom = (event) => {
      if (suppressTap) {
        suppressTap = false;
        return;
      }

      const now = Date.now();
      const closeToLastTap = Math.abs(event.clientX - lastTapX) < 28 && Math.abs(event.clientY - lastTapY) < 28;

      if (now - lastTapAt < 320 && closeToLastTap) {
        event.preventDefault();
        setZoom(zoom > 1.01 ? 1 : 2.2, true);
        lastTapAt = 0;
        return;
      }

      lastTapAt = now;
      lastTapX = event.clientX;
      lastTapY = event.clientY;
    };

    document.querySelectorAll('[data-shots]').forEach((t) => {
      t.addEventListener('click', () => {
        try { open(JSON.parse(t.dataset.shots)); } catch (e) {}
      });
    });
    prevBtn.addEventListener('click', () => go(-1));
    nextBtn.addEventListener('click', () => go(1));
    zoomOutBtn.addEventListener('click', () => setZoom(zoom - 0.45));
    zoomResetBtn.addEventListener('click', resetZoom);
    zoomInBtn.addEventListener('click', () => setZoom(zoom + 0.45));
    stage.addEventListener('pointerdown', startGesture);
    stage.addEventListener('pointermove', moveGesture);
    stage.addEventListener('pointerup', endGesture);
    stage.addEventListener('pointercancel', cancelGesture);
    stage.addEventListener('click', handleTapZoom);
    lb.querySelectorAll('[data-close]').forEach((c) => c.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
      else if (e.key === '+' || e.key === '=') setZoom(zoom + 0.45);
      else if (e.key === '-') setZoom(zoom - 0.45);
      else if (e.key === '0') resetZoom();
    });
  }
</script>
