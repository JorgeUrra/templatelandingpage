---
import SectionHeader from '../shared/SectionHeader.astro';
import Button from '../shared/Button.astro';
import { ownApps, solutionCases, portfolioIntro, statusLabels } from '../../data/portfolio';
---

<section class="section" id="portafolio">
  <div class="container">
    <SectionHeader
      eyebrow="Proyectos y experiencia"
      title="Experiencia aplicada"
      description={portfolioIntro}
    />

    <!-- Aplicaciones propias -->
    <div class="portfolio-subsection">
      <h3 class="subsection-label">Aplicaciones publicadas y en desarrollo</h3>
      <div class="grid grid--2">
        {ownApps.map((app) => (
          <article class="card portfolio-app-card">
            <div class="app-card-header">
              <div class="app-icon-badge">{app.icon}</div>
              <span class={`app-status app-status--${app.status}`}>
                {statusLabels[app.status]}
              </span>
            </div>
            <h3>{app.name}</h3>
            <p>{app.description}</p>
            <div class="tech-tags">
              {app.stack.map((tech) => <span class="tech-tag">{tech}</span>)}
            </div>
            <div class="app-actions">
              {app.platforms.includes('google-play') && (
                app.playStoreUrl
                  ? <Button href={app.playStoreUrl} target="_blank" label="Ver en Google Play" variant="primary" />
                  : <span class="btn-placeholder">Próximamente en Google Play</span>
              )}
              {app.platforms.includes('app-store') && (
                app.appStoreUrl
                  ? <Button href={app.appStoreUrl} target="_blank" label="Ver en App Store" variant="secondary" />
                  : <span class="btn-placeholder">Próximamente en App Store</span>
              )}
              {app.detailUrl && (
                <Button href={app.detailUrl} label="Ver detalle" variant="ghost" />
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Casos de solución -->
    <div class="portfolio-subsection">
      <h3 class="subsection-label">Casos de solución desarrollados</h3>
      <div class="grid grid--2">
        {solutionCases.map((item, i) => (
          <article class="card portfolio-case-card">
            <span class="case-number">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.areas && item.areas.length > 0 && (
              <div class="case-areas">
                {item.areas.map((area) => <span class="case-area">{area}</span>)}
              </div>
            )}
            <div class="tech-tags">
              {item.stack.map((tech) => <span class="tech-tag">{tech}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
