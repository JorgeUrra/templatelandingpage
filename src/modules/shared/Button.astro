---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'whatsapp';
  label: string;
  target?: string;
  icon?: 'arrow' | 'none';
}
const { href, variant = 'primary', label, target, icon } = Astro.props;
const rel = target === '_blank' ? 'noopener' : undefined;
const showArrow = variant !== 'whatsapp' && icon !== 'none';
---
<a class:list={["btn", `btn--${variant}`]} href={href} target={target} rel={rel}>
  {variant === 'whatsapp' && <span class="btn__wa-icon" aria-hidden="true"></span>}
  <span>{label}</span>
  {showArrow && (
    <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )}
</a>
