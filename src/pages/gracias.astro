---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../modules/shared/Button.astro';
---
<BaseLayout title="Gracias por contactarnos">
  <section class="section thank-you">
    <div class="container container--narrow card">
      <span class="eyebrow">Solicitud recibida</span>
      <h1>Gracias por contactarnos</h1>
      <p>Esta página confirma el envío del formulario. En producción puedes conectar el formulario a WhatsApp, Formspree, Tally, Netlify Forms, Google Sheets o una API propia.</p>
      <Button href="/" label="Volver al inicio" />
    </div>
  </section>
</BaseLayout>
